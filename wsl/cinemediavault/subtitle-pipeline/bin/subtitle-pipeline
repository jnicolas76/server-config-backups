#!/usr/bin/env bash
set -euo pipefail
python_root="$HOME/.local/share/cinevault-subtitles/venv"
cuda_libs="$($python_root/bin/python - <<'PY'
from pathlib import Path
from importlib.util import find_spec
print(":".join(str(Path(find_spec(name).submodule_search_locations[0]) / "lib") for name in ("nvidia.cublas", "nvidia.cudnn")))
PY
)"
export LD_LIBRARY_PATH="$cuda_libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HOME/.local/share/cinevault-subtitles/venv/bin/python" "$HOME/.local/share/cinevault-subtitles/cinevault_subtitles.py" "$@"
