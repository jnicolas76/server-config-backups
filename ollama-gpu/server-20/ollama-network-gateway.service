[Unit]
Description=Ollama Home Network Read-Only Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jnicolas
Group=jnicolas
ExecStart=/usr/bin/python3 /opt/ollama-network-gateway/gateway.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/jnicolas/.ssh /home/jnicolas/.config/ollama-network-gateway

[Install]
WantedBy=multi-user.target
