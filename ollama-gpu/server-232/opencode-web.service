[Unit]
Description=OpenCode password-protected development agent web interface
After=network-online.target ollama-gpu.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jnicolas/dev-agent-workspace
Environment=HOME=/home/jnicolas
Environment=PATH=/home/jnicolas/.opencode/bin:/home/jnicolas/.local/bin:/usr/bin:/bin
Environment=OPENCODE_SERVER_USERNAME=jnicolas
EnvironmentFile=/home/jnicolas/.config/opencode/web.env
ExecStart=/home/jnicolas/.opencode/bin/opencode web --hostname 0.0.0.0 --port 4096
Restart=on-failure
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=default.target
